<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kapitel 20: ohctl als .NET-Tool: dotnet tool install -g ohctl -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ohctl</ToolCommandName>
    <PackageId>ohctl</PackageId>
    <Version>1.0.0</Version>
    <Authors>Michael Christian Dörflinger</Authors>
    <Description>openHAB auf der Kommandozeile (Beispiel zum Buch)</Description>
    <PackageOutputPath>../../nupkg</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CSharpOpenHABRestClient" Version="2.0.0" />
  </ItemGroup>
</Project>
