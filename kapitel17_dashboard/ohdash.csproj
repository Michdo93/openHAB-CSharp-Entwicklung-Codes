<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kapitel 17: ohdash – ein Dashboard für openHAB nach MVVM (Avalonia) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CSharpOpenHABRestClient" Version="2.0.1" />
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <!-- nur für die Option "bild": das Fenster ohne Bildschirm zeichnen -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.6" />
  </ItemGroup>
</Project>
